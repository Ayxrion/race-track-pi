#pragma once
// Optional: live telemetry for the 3D spectator web viewer.
// Copy to telemetry_config.h (gitignored) and flash once over USB. The board
// saves the URL and token in its settings memory, so they survive OTA updates
// (release binaries are public and never contain the token).
// Send `telemetry off` on the serial port to clear them again.
#define RT_TELEMETRY_ENABLED 1
#define RT_TELEMETRY_URL "https://race.example.com/api/publish"
#define RT_TELEMETRY_TOKEN "REPLACE_WITH_THE_RELAY_PUBLISH_TOKEN"   // at least 32 characters
#define RT_TELEMETRY_INTERVAL_MS 100
